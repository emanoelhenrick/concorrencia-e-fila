# Postgres é necessário porque o experimento depende de:
#  - SELECT ... FOR UPDATE (lock pessimista de linha)
#  - Nível de isolamento SERIALIZABLE em transação
# SQLite não oferece essas garantias de forma equivalente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estoque_concorrente?schema=public"
PORT=3000

# Redis usado pela fila de mensagens (BullMQ) que processa notificações
# de forma assíncrona/desacoplada da requisição HTTP de checkout.
REDIS_URL="redis://localhost:6379"
