{
  "name": "estoque-concorrente",
  "version": "1.0.0",
  "description": "Simulacao de concorrencia no estoque de produtos (checkout) com Node, TypeScript, Prisma e Express",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/queue/worker.ts",
    "worker:start": "node dist/queue/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test:concurrency:pessimistic": "ts-node scripts/concurrency-test.ts pessimistic",
    "test:concurrency:optimistic": "ts-node scripts/concurrency-test.ts optimistic",
    "test:concurrency:naive": "ts-node scripts/concurrency-test.ts naive",
    
    "test:concurrency:k6:naive": "k6 run -e STRATEGY=naive scripts/concurrency-test.k6.ts",
    "test:concurrency:k6:pessimistic": "k6 run -e STRATEGY=pessimistic scripts/concurrency-test.k6.ts",
    "test:concurrency:k6:optimistic": "k6 run -e STRATEGY=optimistic scripts/concurrency-test.k6.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bullmq": "^5.12.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/k6": "^2.2.1",
    "@types/node": "^20.14.10",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
